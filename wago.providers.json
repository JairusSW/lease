{
  "$schema": "https://wago.sh/v1/providers.schema.json",
  "providers": [
    {
      "importPath": "github.com/JairusSW/lease/register",
      "definition": {
        "id": "github.com/JairusSW/lease",
        "name": "Lease",
        "version": "0.1.1",
        "description": "Bounded pools of clean WebAssembly instances for one-shot execution.",
        "stability": "experimental",
        "compatibility": {
          "engines": {
            "wago": "\u003e=0.1.0"
          }
        },
        "provenance": {
          "homepage": "https://github.com/JairusSW/lease",
          "repository": "https://github.com/JairusSW/lease",
          "license": "Apache-2.0",
          "authors": [
            "Jairus Tanaka"
          ]
        },
        "configSchema": {
          "additionalProperties": false,
          "properties": {
            "acquireTimeoutMillis": {
              "maximum": 86400000,
              "minimum": 0,
              "type": "integer"
            },
            "maxLive": {
              "maximum": 1024,
              "minimum": 1,
              "type": "integer"
            },
            "maxSources": {
              "maximum": 1024,
              "minimum": 1,
              "type": "integer"
            },
            "minIdle": {
              "maximum": 1024,
              "minimum": 0,
              "type": "integer"
            },
            "release": {
              "enum": [
                "reset",
                "reuse"
              ],
              "type": "string"
            }
          },
          "type": "object"
        },
        "provides": [
          {
            "id": "github.com/JairusSW/lease/service",
            "major": 1
          }
        ],
        "consumes": [
          {
            "id": "github.com/JairusSW/lease/source",
            "major": 1,
            "mode": "many"
          }
        ]
      },
      "definitionDigest": "sha256:9ce715de4c0c95cbbe442e1c0522e84052f15c68c1b75405c064d3f01a57e848"
    }
  ]
